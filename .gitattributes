# Preserve imported archive bytes, including original line endings.
ATtiny13A/Music/** -text
# Firmware and packed waveform banks must retain every byte, even without NUL.
ATtiny88/Music/**/*.bin binary
ATtiny13A/Sound/** -text
ATmega328/** -text
PIC16F1503/** -text
# Pinned manufacturer inputs and provenance retain their exact bytes.
web-player/vendor/microchip/ATtiny_DFP/3.4.278/** -text -whitespace
ATtiny88/Music/universal/vendor/ATtiny_DFP/3.4.278/** -text -whitespace
web-player/audio/speech-previews/** -text
web-player/audio/lpx-speech/** -text
web-player/audio/lpx-dialogue/** -text
web-player/audio/speech-waveforms/** -text
# Download checksums cover the exact generated Nano Intel HEX bytes.
web-player/firmware/arduino-nano/*.hex -text -whitespace
# Retained Tiny88 download checksums also cover exact Intel HEX bytes.
web-player/firmware/attiny88/*.hex -text -whitespace
ATtiny13A/Music/docs/*.pdf filter=lfs diff=lfs merge=lfs -text
