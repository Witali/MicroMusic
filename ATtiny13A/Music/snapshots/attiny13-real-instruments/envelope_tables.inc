/* 12 time-grid points per recorded note, 4 bits per measured RMS value.
 * Time points in milliseconds: 5,15,35,70,120,200,350,500,600,665,710,800
 * Note-off was at 650 ms; values after that model release.
 * 9 envelopes x 6 bytes = 54 FLASH bytes. */
 .section .text
instrument_envelopes:
 /* violin low  */
 .byte 0x52, 0xea, 0xfe, 0xef, 0x7e, 0x01
 /* violin mid  */
 .byte 0x21, 0xe9, 0xfe, 0xef, 0x8e, 0x01
 /* violin high */
 .byte 0x53, 0xf7, 0xff, 0xee, 0x8e, 0x01
 /* piano  low  */
 .byte 0xd8, 0xee, 0x9b, 0x45, 0x23, 0x01
 /* piano  mid  */
 .byte 0xfa, 0xfe, 0xce, 0x79, 0x56, 0x13
 /* piano  high */
 .byte 0xfc, 0xcf, 0x59, 0x12, 0x10, 0x00
 /* guitar low  */
 .byte 0xb4, 0xee, 0xdf, 0xaa, 0x6a, 0x14
 /* guitar mid  */
 .byte 0xfc, 0xac, 0x9a, 0x67, 0x46, 0x02
 /* guitar high */
 .byte 0xf9, 0xce, 0xab, 0x79, 0x46, 0x02
