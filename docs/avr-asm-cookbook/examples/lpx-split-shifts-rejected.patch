@@ -200,6 +200,22 @@ int8_t Lpx4HybridCore::readHuffman3(){
  if(!readOne())return 3;
  return readOne()?-3:-4;
 }
+// Split a byte shift at4 bits to exploit AVR SWAP/ANDI before the short loop.
+// Bits1/2 select right/left shifts; zero retains the original expressions.
+#ifndef LPX4_SPLIT_BIT_SHIFTS
+#define LPX4_SPLIT_BIT_SHIFTS 2
+#endif
+#if LPX4_SPLIT_BIT_SHIFTS < 0 || LPX4_SPLIT_BIT_SHIFTS > 3
+#error LPX4_SPLIT_BIT_SHIFTS must be0..3
+#endif
+static inline __attribute__((always_inline)) uint8_t byteShiftRight(uint8_t value,uint8_t n){
+ if(n>=4){value>>=4;n-=4;}
+ return value>>n;
+}
+static inline __attribute__((always_inline)) uint8_t byteShiftLeft(uint8_t value,uint8_t n){
+ if(n>=4){value=(uint8_t)(value<<4);n-=4;}
+ return (uint8_t)(value<<n);
+}
 uint8_t Lpx4HybridCore::readBits(uint8_t n){
 #ifdef LPX3_COST_INSTRUMENT
  ++bitCalls_;
@@ -208,11 +224,25 @@ uint8_t Lpx4HybridCore::readBits(uint8_t n){
  uint8_t out;
  if(available>=n){
   out=bitBuffer_&LP_READ_U8(&bitMasks[n]);
-  bitBuffer_>>=n;bitsLeft_=available-n;
+#if LPX4_SPLIT_BIT_SHIFTS&1
+  bitBuffer_=byteShiftRight(bitBuffer_,n);
+#else
+  bitBuffer_>>=n;
+#endif
+  bitsLeft_=available-n;
  }else{
   const uint8_t extra=readByte(),need=n-available;
+#if LPX4_SPLIT_BIT_SHIFTS&2
+  out=bitBuffer_|byteShiftLeft(extra&LP_READ_U8(&bitMasks[need]),available);
+#else
   out=bitBuffer_|((extra&LP_READ_U8(&bitMasks[need]))<<available);
-  bitBuffer_=extra>>need;bitsLeft_=8-need;
+#endif
+#if LPX4_SPLIT_BIT_SHIFTS&1
+  bitBuffer_=byteShiftRight(extra,need);
+#else
+  bitBuffer_=extra>>need;
+#endif
+  bitsLeft_=8-need;
  }
  return out;
 }
