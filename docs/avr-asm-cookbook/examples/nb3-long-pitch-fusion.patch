+/* Experimental long-pitch fusion; source is all negative history. */
+static __attribute__((optimize("O2"))) SPEEX_NB3_NOINLINE void long_pitch_innovation(
+    int16_t *out,const int16_t *in,SpeexBits *bits,int32_t scale,unsigned index)
+{
+    const int8_t g0=(int8_t)(32+AVR_READ_I8(gain_cdbk_lbr+index+2));
+    const int8_t g1=(int8_t)(32+AVR_READ_I8(gain_cdbk_lbr+index+1));
+    const int8_t g2=(int8_t)(32+AVR_READ_I8(gain_cdbk_lbr+index));
+    const int16_t scale_high=(int16_t)(scale>>12);
+    const int16_t scale_low=(int16_t)(scale&4095);
+    int16_t a=*in++,b=*in++;
+    unsigned vector,sample;
+    for(vector=0;vector<4;vector++) {
+        unsigned code=speex_bits_unpack_unsigned(bits,5);
+        const int8_t *shape=exc_10_32_table+10*code;
+        for(sample=0;sample<10;sample++) {
+            int16_t c=*in++;
+            int32_t adaptive=(int32_t)g0*a+(int32_t)g1*b+(int32_t)g2*c;
+            int32_t innovation=speex_nb3_shape_scale_c(AVR_READ_I8(shape++),scale_high,scale_low);
+            a=b;b=c;
+            adaptive=SATURATE32(adaptive,2048000);
+            *out++=speex_nb3_saturating_q14_c(ADD32(ADD32(SHL32(adaptive,8),innovation),8192));
+        }
+    }
+}
