+#include <stdint.h>
+#include "nb3_c_math.h"
+_Static_assert(!SPEEX_NB3_USE_AVR_ASM,"Pure C arithmetic workers");
+volatile uint32_t mac_sum,mac_result;
+volatile int16_t mac_a,mac_b;
+volatile uint8_t mac_command,mac_status,mac_zero;
+static SPEEX_NB3_STAGE uint32_t mac_native(uint32_t s,int16_t a,int16_t b)
+{
+    return s+(uint32_t)((int32_t)a*b);
+}
+static SPEEX_NB3_STAGE uint32_t mac_bytes(uint32_t s,int16_t a,int16_t b)
+{
+    return speex_nb3_mac16_bytes_c(s,a,b);
+}
+int main(void)
+{
+    mac_status=1;
+    for (;;) {
+        while(!mac_command) {}
+        if(mac_command==1)mac_result=mac_native(mac_sum,mac_a,mac_b);
+        else mac_result=mac_bytes(mac_sum,mac_a,mac_b);
+        __asm__("mov %0,r1":"=r"(mac_zero));
+        mac_command=0;mac_status=2;
+    }
+}
