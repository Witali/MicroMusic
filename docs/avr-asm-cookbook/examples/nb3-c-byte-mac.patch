+/* Full signed16 MAC modulo 2^32 using only byte products. Each narrow
+ * product fits its declared type; unsigned shifts/additions define wrapping. */
+static SPEEX_NB3_ALWAYS_INLINE uint32_t speex_nb3_mac16_bytes_c(uint32_t sum,
+                                                               int16_t a,int16_t b)
+{
+    uint8_t al=(uint8_t)a,bl=(uint8_t)b;
+    int8_t ah=(int8_t)(a>>8),bh=(int8_t)(b>>8);
+    sum+=(uint16_t)al*bl;
+    sum+=(uint32_t)((int16_t)ah*bh)<<16;
+    sum+=(uint32_t)((int16_t)ah*bl)<<8;
+    sum+=(uint32_t)((int16_t)bh*al)<<8;
+    return sum;
+}

