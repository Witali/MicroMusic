+// Prototype: narrow=true requires every coefficient to fit signed8.
+#ifndef LPX4_AVR_NARROW_UNROLL
+#define LPX4_AVR_NARROW_UNROLL 9
+#endif
+#if LPX4_AVR_NARROW_UNROLL!=1 && LPX4_AVR_NARROW_UNROLL!=3 && LPX4_AVR_NARROW_UNROLL!=9
+#error LPX4_AVR_NARROW_UNROLL must be1,3 or9
+#endif
+#define LPX4_SYNTH_NARROW_MUL \
+    "mulsu r18,r20\n\tmov r23,r1\n\tlsl r1\n\tsbc r24,r24\n\t" \
+    "muls r18,r21\n\tadd r23,r0\n\tadc r24,r1\n\t" \
+    "mov r25,r24\n\tlsl r25\n\tsbc r25,r25\n\t" \
+    "andi r23,0xf0\n\t" \
+    "sub %A0,r23\n\tsbc %B0,r24\n\tsbc %C0,r25\n\tsbc %D0,r16\n\t" \
+    "sbrc r25,7\n\tinc %D0\n\t"
+template<bool excitationQ4=false> static inline __attribute__((always_inline)) int32_t lpx4SynthesisRingAdaptiveQ12(int32_t excitation,const int16_t* a,int16_t*& h,bool narrow){
+#if LPX4_USE_AVR_ASM
+    int32_t result=excitation;
+    __asm__(
+        "clr r16\n\t"
+        ".if %4\n\t.rept 4\n\tlsl %A0\n\trol %B0\n\trol %C0\n\trol %D0\n\t.endr\n\t.endif\n\t"
+        "tst %3\n\tbrne 8f\n\trjmp 4f\n\t8:\n\t"
+        "ld r18,X+\n\tld r19,X+\n\tld r21,-Z\n\tld r20,-Z\n\t"
+        LPX4_SYNTH_NARROW_MUL
+#if LPX4_AVR_NARROW_UNROLL!=9
+        "ldi r17," LPX4_STRING(9/LPX4_AVR_NARROW_UNROLL) "\n\t6:\n\t"
+#endif
+        ".rept " LPX4_STRING(LPX4_AVR_NARROW_UNROLL) "\n\t"
+        "ld r18,X+\n\tld r19,X+\n\tld r21,-Z\n\tld r20,-Z\n\t"
+        LPX4_SYNTH_NARROW_MUL
+        ".endr\n\t"
+#if LPX4_AVR_NARROW_UNROLL!=9
+        "dec r17\n\tbreq 7f\n\trjmp 6b\n\t7:\n\t"
+#endif
+        "rjmp 5f\n\t4:\n\t"
+        "ld r18,X+\n\tld r19,X+\n\tld r21,-Z\n\tld r20,-Z\n\t"
+        LPX4_SYNTH_MUL
+#if LPX4_AVR_DOT_UNROLL!=9
+        "ldi r17," LPX4_STRING(9/LPX4_AVR_DOT_UNROLL) "\n\t1:\n\t"
+#endif
+        ".rept " LPX4_STRING(LPX4_AVR_DOT_UNROLL) "\n\t"
+        "ld r18,X+\n\tld r19,X+\n\tld r21,-Z\n\tld r20,-Z\n\t"
+        LPX4_SYNTH_MUL
+        ".endr\n\t"
+#if LPX4_AVR_DOT_UNROLL!=9
+        "dec r17\n\tbreq 2f\n\trjmp 1b\n\t2:\n\t"
+#endif
+        "5:\n\t.rept 4\n\tasr %D0\n\tror %C0\n\tror %B0\n\tror %A0\n\t.endr\n\tclr __zero_reg__\n\t"
+        : "+&r"(result),"+z"(h),"+x"(a)
+        : "r"(narrow),"I"(!excitationQ4)
+        : "r0","r1","r16","r18","r19","r20","r21","r22","r23","r24","r25",
+#if LPX4_AVR_DOT_UNROLL!=9 || LPX4_AVR_NARROW_UNROLL!=9
+          "r17",
+#endif
+          "cc","memory");
+    return result;
+#else
+    (void)narrow;
+    int32_t result=excitationQ4?excitation/16:excitation;
+    for(uint8_t i=0;i<10;i++)result-=((int32_t)a[i]*h[-1-i])>>12;
+    h-=10;return result;
+#endif
+}
+#undef LPX4_SYNTH_NARROW_MUL
